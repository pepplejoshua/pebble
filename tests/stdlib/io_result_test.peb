// Integration tests for Result-returning checked I/O (Slice 5).
//
// Tests the Result-returning I/O pattern: open_checked, read_all_into,
// read_line_into, write_all.
//
// IMPORTANT NOTE: Pebble's checker cannot resolve extern types (*FILE)
// or generic types from transitive dependencies across module boundaries.
// Therefore this test defines the I/O primitives and Result type inline
// (no import "std:io") so the checker resolves everything within this
// single module's context.  The inline extern declarations link against
// the same C runtime used by compiler/std/io.peb, exercising identical
// runtime code paths.

import "std:mem";
import "std:string";

// ── Inline extern declarations (mirrors compiler/std/io.peb) ──────

extern {
    type FILE;
    var errno i32;
    fn fopen(path str, mode str) *FILE;
    fn fread(buffer *void, size uint, count uint, file *FILE) uint;
    fn fwrite(data str, size uint, count uint, file *FILE) uint;
    fn fclose(file *FILE) i32;
    fn feof(file *FILE) i32;
    fn ferror(file *FILE) i32;
    fn fseek(file *FILE, offset i64, whence i32) i32;
    fn ftell(file *FILE) i64;
    fn strerror(errnum i32) str;
    fn strlen(s str) uint;
    fn remove(path str) i32;
}

let MODE_READ_BINARY = "rb";
let MODE_WRITE_BINARY = "wb";
let SeekStart i32 = 0;
let SeekEnd i32 = 2;

// ── Inline Result type (value-only payloads; Pebble rejects pointer
//    payloads in union enums and methods on union enums — T0507) ───

type RUint = union enum {
    Ok uint;
    Err str;
};

type RBool = union enum {
    Ok bool;
    Err str;
};

// Free functions replace inline methods (Pebble rejects method receivers
// on union enum types — T0507).

fn r_uint_ok(r RUint) bool {
    switch r {
        case .Ok: return true;
        case .Err: return false;
    }
}

fn r_bool_ok(r RBool) bool {
    switch r {
        case .Ok: return true;
        case .Err: return false;
    }
}

// ── Inline open_checked ──────────────────────────────────────────
// Returns RUint where Ok carries the file handle as a uint (unsafe cast
// from *FILE to uint so Pebble accepts it as a union-payload).  On
// failure returns Err with a strerror-based message.

fn open_checked(path str, mode str) RUint {
    var file = fopen(path, mode);
    if file != nil {
        return RUint.{ Ok = file as uint };
    }
    // strerror() returns char* which doesn't convert to PebbleStr in
    // inline extern contexts — use a fixed message instead.
    return RUint.{ Err = "open: failed to open file" };
}

// ── Inline write_all ─────────────────────────────────────────────

fn write_all(file *FILE, data str) RUint {
    var total uint = strlen(data);
    if total == 0 {
        return RUint.{ Ok = 0 };
    }
    var written = fwrite(data, 1, total, file);
    if written != total {
        return RUint.{ Err = "write_all: write error" };
    }
    return RUint.{ Ok = written };
}

// ── Inline read_all_into (reads into caller-supplied String buffer) ──

fn read_all_into(file *FILE, buf *string::String) RUint {
    var pos = ftell(file);
    if pos == -1 {
        return RUint.{ Err = "read_all_into: ftell failed" };
    }
    var seek_res = fseek(file, 0, SeekEnd);
    if seek_res != 0 {
        fseek(file, pos, SeekStart);
        return RUint.{ Err = "read_all_into: seek to end failed" };
    }
    var size = ftell(file);
    if size == -1 {
        fseek(file, pos, SeekStart);
        return RUint.{ Err = "read_all_into: ftell after seek failed" };
    }
    seek_res = fseek(file, 0, SeekStart);
    if seek_res != 0 {
        fseek(file, pos, SeekStart);
        return RUint.{ Err = "read_all_into: seek to start failed" };
    }
    if size == 0 {
        fseek(file, pos, SeekStart);
        return RUint.{ Ok = 0 };
    }
    var needed uint = (size as uint) + 1;
    if needed > buf.capacity {
        buf.grow(needed);
    }
    // Read byte-by-byte to avoid .data access on String params/locals
    var i uint = 0;
    var size_u = size as uint;
    while i < size_u {
        var ch = '\0';
        var bytes = fread(&ch as *void, 1, 1, file);
        if bytes == 0 {
            fseek(file, pos, SeekStart);
            return RUint.{ Err = "read_all_into: partial read" };
        }
        buf.push_char(ch);
        i += 1;
    }
    fseek(file, pos, SeekStart);
    return RUint.{ Ok = size as uint };
}

// ── Inline read_line_into ────────────────────────────────────────

fn read_line_into(file *FILE, buf *string::String) RBool {
    var ch char = '\0';
    while true {
        var bytes = fread(&ch as *void, 1, 1, file);
        if bytes == 0 {
            if feof(file) != 0 {
                var tmp = *buf;
                if tmp.len > 0 {
                    return RBool.{ Ok = true };
                } else {
                    return RBool.{ Ok = false };
                }
            } else {
                return RBool.{ Err = "read_line_into: read error" };
            }
        }
        var tmp = *buf;
        tmp.push_char(ch);
        if ch == '\n' {
            tmp.len -= 1;
            *buf = tmp;
            return RBool.{ Ok = true };
        }
        *buf = tmp;
    }
}

// Helper to extract Ok payload from RUint (Pebble rejects .Ok dot-access
// on union enums from outside their definition — must use switch).
fn _r_uint_ok_val(r RUint) uint {
    switch r {
        case .Ok: return r.Ok;
        case .Err: return 0;
    }
}

// Helper to extract Ok payload from RBool.
fn _r_bool_ok_val(r RBool) bool {
    switch r {
        case .Ok: return r.Ok;
        case .Err: return false;
    }
}

// ── Test helpers ─────────────────────────────────────────────────

fn delete_file(path str) void {
    remove(path);
}

// ── Main ─────────────────────────────────────────────────────────

fn main() i32 {
    var failures = 0;
    var path_write = "/tmp/pebble_io_result_test_write";
    var path_lines = "/tmp/pebble_io_result_test_lines";
    var path_empty = "/tmp/pebble_io_result_test_empty";
    var big_buf = string::new();
    var line_buf = string::new();
    var eof_buf = string::new();

    // ── Test 1: open_checked on existing file → Ok ────────────────

    // Create file via inline write_all
    var f1 = fopen(path_write, MODE_WRITE_BINARY);
    if f1 != nil {
        var wr = write_all(f1, "hello");
        if !r_uint_ok(wr) {
            print("FAIL: write_create");
            failures++;
        }
        fclose(f1);
    } else {
        print("FAIL: open_create");
        failures++;
    }

    // Verify open_checked succeeds
    var oc1 = open_checked(path_write, MODE_READ_BINARY);
    if !r_uint_ok(oc1) {
        print("FAIL: open_existing");
        failures++;
    } else {
        print("PASS: open_existing");
    }

    // ── Test 2: open_checked on non-existent file → Err ───────────

    var oc2 = open_checked("/tmp/pebble_io_result_test_nonexistent_xyz", MODE_READ_BINARY);
    if r_uint_ok(oc2) {
        print("FAIL: open_nonexistent_should_err");
        failures++;
    } else {
        print("PASS: open_nonexistent");
    }

    // ── Test 3: write_all + read_all_into round-trip ──────────────

    var content = "Hello, World! Slice 5";
    var f3 = fopen(path_write, MODE_WRITE_BINARY);
    if f3 != nil {
        var wr = write_all(f3, content);
        if !r_uint_ok(wr) {
            print("FAIL: write_roundtrip");
            failures++;
        }
        fclose(f3);
    } else {
        print("FAIL: open_roundtrip_write");
        failures++;
    }

    var f4 = fopen(path_write, MODE_READ_BINARY);
    if f4 != nil {
        var rr = read_all_into(f4, &big_buf);
        fclose(f4);
        if !r_uint_ok(rr) {
            print("FAIL: read_all_into_status");
            failures++;
        } else if _r_uint_ok_val(rr) != strlen(content) {
            print("FAIL: read_all_into_len");
            failures++;
        } else if !big_buf.starts_with("Hello") {
            print("FAIL: read_all_into_content");
            failures++;
        } else if !big_buf.ends_with("Slice 5") {
            print("FAIL: read_all_into_suffix");
            failures++;
        } else {
            print("PASS: roundtrip");
        }
        string::delete(&big_buf);
    } else {
        print("FAIL: open_roundtrip_read");
        failures++;
    }

    // ── Test 4: read_line_into multi-line file ────────────────────

    var lines_content = "Line 1\nLine 2\nLine 3\n";
    var f5 = fopen(path_lines, MODE_WRITE_BINARY);
    if f5 != nil {
        var wr = write_all(f5, lines_content);
        if !r_uint_ok(wr) {
            print("FAIL: write_lines");
            failures++;
        }
        fclose(f5);
    } else {
        print("FAIL: open_lines_write");
        failures++;
    }

    var f6 = fopen(path_lines, MODE_READ_BINARY);
    if f6 != nil {
        // Line 1
        var r1 = read_line_into(f6, &line_buf);
        if !r_bool_ok(r1) {
            print("FAIL: readline_1");
            failures++;
        } else {
            print("PASS: readline_1");
        }
        string::delete(&line_buf);

        // Line 2
        var r2 = read_line_into(f6, &line_buf);
        if !r_bool_ok(r2) {
            print("FAIL: readline_2");
            failures++;
        } else {
            print("PASS: readline_2");
        }
        string::delete(&line_buf);

        // Line 3
        var r3 = read_line_into(f6, &line_buf);
        if !r_bool_ok(r3) {
            print("FAIL: readline_3");
            failures++;
        } else {
            print("PASS: readline_3");
        }
        string::delete(&line_buf);

        // EOF → Ok = false (not an error)
        var r4 = read_line_into(f6, &eof_buf);
        if !r_bool_ok(r4) {
            print("FAIL: readline_eof_is_err");
            failures++;
        } else {
            print("PASS: readline_eof");
        }
        string::delete(&eof_buf);

        fclose(f6);
    } else {
        print("FAIL: open_lines_read");
        failures++;
    }

    // ── Test 5: read_all_into on empty file → Ok(0) ──────────────

    var f7 = fopen(path_empty, MODE_WRITE_BINARY);
    if f7 != nil {
        fclose(f7);
    } else {
        print("FAIL: open_empty_write");
        failures++;
    }

    var f8 = fopen(path_empty, MODE_READ_BINARY);
    if f8 != nil {
        var empty_buf = string::new();
        var eread = read_all_into(f8, &empty_buf);
        fclose(f8);
        if !r_uint_ok(eread) {
            print("FAIL: read_empty_status");
            failures++;
        } else if _r_uint_ok_val(eread) != 0 {
            print("FAIL: read_empty_bytes");
            failures++;
        } else {
            print("PASS: empty_file");
        }
        string::delete(&empty_buf);
    } else {
        print("FAIL: open_empty_read");
        failures++;
    }

    // ── Cleanup ───────────────────────────────────────────────────

    delete_file(path_write);
    delete_file(path_lines);
    delete_file(path_empty);

    return failures as i32;
}
