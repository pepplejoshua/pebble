type Color = enum { red, green, blue };
type Choice = union enum { empty void; value i32; };

fn shade(color Color) i32 {
    switch color {
    case Color.red:
        return 1;
    case Color.green, Color.blue:
        return 2;
    else:
        return 0;
    }
}

fn pick(choice Choice) i32 {
    switch choice {
    case Choice.empty:
        return 0;
    case Choice.value:
        return 2;
    else:
        return 1;
    }
}
