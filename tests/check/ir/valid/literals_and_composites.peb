type Color = enum { red, blue };
type Pair = struct { left i32; right i32; };

let flag bool = true;
let letter char = 'x';
let text str = "hello";
let number i32 = 42;
let decimal f64 = 3.14;
let pair Pair = Pair.{ left = 1, right = 2 };
let color Color = Color.red;

fn values() i32 {
    let tuple (i32, i32) = (1, 2);
    let array = [1, 2, 3];
    let repeated [3]i32 = [1; 3];
    let width uint = sizeof i32;
    return width as i32;
}
