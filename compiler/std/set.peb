import "std:mem";

type EntryState = enum {
    Empty,      // Never used
    Tombstone,  // Previously used, now deleted
    Occupied,   // Actively holds a key-value pair
};

type Entry[K] = struct {
    key K;
    state EntryState;
};

type Set[K] = struct {
    entries []Entry[K];
    len     uint;       // number of OCCUPIED entries
    cap     uint;       // number of slots in table
    hash_fn fn (K) u64;
    eq_fn   fn (K, K) bool;
    backing Allocator;

    // Double capacity when load factor > 0.7
    fn maybe_grow[K](self *Set[K]) void {
        // Always grow if capacity is 0
        if self.cap == 0 {
            self.rehash(8);
            return;
        }

        // Check load factor: if < 0.7, no need to grow
        if (self.len * 10) / self.cap < 7 {
            return;
        }

        self.rehash(self.cap * 2);
    }

    // Rehash into a new table with new_cap buckets.
    fn rehash[K](self *Set[K], new_cap uint) void {
        let allocator = self.backing;
        let new_size = new_cap * (sizeof Entry[K]);
        let ptr *Entry[K] = allocator.alloc(allocator.ptr, new_size) as *Entry[K];
        let new_entries []Entry[K] = slice ptr, new_cap;

        // Initialize
        loop 0..new_cap : i {
            new_entries[i].state = .Empty;
        }

        // Move entries
        var old_entries = self.entries;
        var old_cap = self.cap;

        self.entries = new_entries;
        self.cap = new_cap;
        self.len = 0;

        // Re-insert old items
        if old_cap != 0 {
            loop 0..old_cap : j {
                let e = old_entries[j];
                if e.state == .Occupied {
                    self.insert(e.key);
                }
            }
            allocator.free(allocator.ptr, old_entries.data as *void);
        }
    }

    // Insert or replace a key entry.
    fn insert[K](self *Set[K], key K) void {
        self.maybe_grow();

        let hash = self.hash_fn(key);
        var index = (hash as uint) % self.cap;
        var tombstone_index ?uint = none;

        // Bounded linear probe: self.cap probes is the exact, provably
        // sufficient upper bound — step-1 probing over cap slots visits every
        // distinct index before repeating, and maybe_grow keeps the load factor
        // under 0.7, so at least 30% of slots are always .Empty and an insert
        // can never need more than cap probes. Exhausting the bound is
        // defensive-only, unreachable in correct operation.
        for var probes = 0; probes < self.cap; probes += 1 {
            let entry = &self.entries[index];

            if entry.state == .Empty {
                // Prefer first tombstone if found
                if tombstone_index.has_value {
                    let t = tombstone_index!;
                    let slot = &self.entries[t];
                    slot.key = key;
                    slot.state = .Occupied;
                    self.len += 1;
                } else {
                    entry.key = key;
                    entry.state = .Occupied;
                    self.len += 1;
                }
                return;
            }

            if entry.state == .Tombstone && !tombstone_index.has_value {
                tombstone_index = some index;
            }

            if entry.state == .Occupied && self.eq_fn(entry.key, key) {
                return; // Do nothing
            }

            index = (index + 1) % self.cap;
        }

        // Bound exhausted — provably unreachable in correct operation (see the
        // loop comment: maybe_grow guarantees an .Empty slot within cap
        // probes). Never silently drop a key though: if a tombstone was
        // recorded during the scan, write the key into it. Only when no
        // tombstone was found either (table 100% .Occupied, no matching key)
        // do nothing at all — touching entries/len there could only corrupt an
        // already-inconsistent table.
        if tombstone_index.has_value {
            let t = tombstone_index!;
            let slot = &self.entries[t];
            slot.key = key;
            slot.state = .Occupied;
            self.len += 1;
        }
    }

    // Check if the set contains a key
    fn contains[K](self *Set[K], key K) bool {
        if self.cap == 0 {
            return false;
        }

        let hash = self.hash_fn(key);
        var index = (hash as uint) % self.cap;

        // Bounded linear probe (defensive): self.cap probes is the exact bound
        // — step-1 probing visits every slot before repeating, and maybe_grow
        // keeps the load factor under 0.7 so an .Empty slot is always reached
        // within it. Exhausting the bound means the invariants were violated;
        // "not present" is the safe, correct answer.
        for var probes = 0; probes < self.cap; probes += 1 {
            let entry = &self.entries[index];

            if entry.state == .Empty {
                return false;
            }

            if entry.state == .Occupied && self.eq_fn(entry.key, key) {
                return true;
            }

            index = (index + 1) % self.cap;
        }

        return false;
    }

    // Remove a key. Returns true if removed.
    fn remove[K](self *Set[K], key K) bool {
        if self.cap == 0 {
            return false;
        }

        let hash = self.hash_fn(key);
        var index = (hash as uint) % self.cap;

        // Bounded linear probe (defensive): self.cap probes is the exact bound
        // — step-1 probing visits every slot before repeating, and maybe_grow
        // keeps the load factor under 0.7 so an .Empty slot is always reached
        // within it. Exhausting the bound means the invariants were violated;
        // "nothing to remove" is the safe, correct answer.
        for var probes = 0; probes < self.cap; probes += 1 {
            let entry = &self.entries[index];

            if entry.state == .Empty {
                return false; // not found
            }

            if entry.state == .Occupied && self.eq_fn(entry.key, key) {
                entry.state = .Tombstone;
                self.len -= 1;
                return true;
            }

            index = (index + 1) % self.cap;
        }

        return false;
    }

    // Remove all key entries but keep capacity.
    fn clear[K](self *Set[K]) void {
        loop 0..self.cap : i {
            self.entries[i].state = .Empty;
        }
        self.len = 0;
    }
};

// Create an empty set with default capacity.
fn new[K](hash_fn fn (K) u64, eq_fn fn (K, K) bool) Set[K] {
    let empty *Entry[K] = nil;
    return Set[K].{
        entries = slice empty, 0,
        len     = 0,
        cap     = 0,
        hash_fn = hash_fn,
        eq_fn   = eq_fn,
        backing = context.default_allocator,
    };
}

// Create set with specified capacity.
fn with_capacity[K](cap uint, hash_fn fn (K) u64,
                        eq_fn fn (K, K) bool) Set[K] {
    if cap == 0 {
        return new[K](hash_fn, eq_fn);
    }

    let allocator = context.default_allocator;
    let size = cap * (sizeof Entry[K]);
    let ptr *Entry[K] = allocator.alloc(allocator.ptr, size) as *Entry[K];
    let entries []Entry[K] = slice ptr, cap;

    // Initialize all states to Empty
    loop 0..cap : i {
        entries[i].state = .Empty;
    }

    return Set[K].{
        entries = entries,
        len     = 0,
        cap     = cap,
        hash_fn = hash_fn,
        eq_fn   = eq_fn,
        backing = allocator,
    };
}

// Delete the entire set and free memory.
fn delete[K](self *Set[K]) void {
    if self.cap != 0 {
        self.backing.free(self.backing.ptr, self.entries.data as *void);
        let empty *Entry[K] = nil;
        self.entries = slice empty, 0;
        self.len = 0;
        self.cap = 0;
    }
}
