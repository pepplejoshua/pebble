import "std:mem";

fn map[T, Ret](items []T, operation fn(T) Ret) []Ret {
    var result = mem::new_slice[Ret](items.len);

    loop 0..items.len : i {
        result[i] = operation(items[i]);
    }

    return result;
}

fn filter[T](items []T, predicate fn(T) bool) []T {
    var result []T = mem::new_slice[T](items.len);
    var count = 0;

    loop 0..items.len : i {
        if predicate(items[i]) {
            result[count] = items[i];
            count++;
        }
    }

    return result[:count]; // Trim to actual size
}

fn reduce[T, Acc](items []T, initial Acc, combine fn(Acc, T) Acc) Acc {
    var accumulator = initial;

    loop 0..items.len : i {
        accumulator = combine(accumulator, items[i]);
    }

    return accumulator;
}

fn find[T](items []T, predicate fn(T) bool) ?T {
    loop 0..items.len : i {
        if predicate(items[i]) {
            return some items[i];
        }
    }
    return none;
}

fn any[T](items []T, predicate fn(T) bool) bool {
    loop 0..items.len : i {
        if predicate(items[i]) {
            return true;
        }
    }
    return false;
}

fn all[T](items []T, predicate fn(T) bool) bool {
    loop 0..items.len : i {
        if !predicate(items[i]) {
            return false;
        }
    }
    return true;
}

fn zip[T, U](items1 []T, items2 []U) [](T, U) {
    var min_len = items1.len;
    if items2.len < min_len {
        min_len = items2.len;
    }

    var result [](T, U) = mem::new_slice[(T, U)](min_len);

    loop 0..min_len : i {
        result[i] = (items1[i], items2[i]);
    }

    return result;
}

// ── Public test helpers via internal wrappers (Slice 7) ─────────────
// Passing a named function value as an argument to a generic higher-order
// function from an external module fails with T0505/T0510 errors because
// the concrete function type does not unify with the generic fn(T) Ret
// parameter shape across module boundaries.  These wrapper functions are
// defined here so they can pass function values to map/filter/reduce/find/
// any/all/zip INTERNALLY (the limitation is specific to crossing a module
// boundary, not to using these functions at all).  Each wrapper exposes
// only slice or primitive return types that cross module boundaries
// cleanly, letting external tests exercise real compiled-and-run logic.

fn _double(x i32) i32 {
    return x * 2;
}

fn _is_even(x i32) bool {
    return x % 2 == 0;
}

fn _sum(acc i32, x i32) i32 {
    return acc + x;
}

fn _to_bool(x i32) bool {
    return x != 0;
}

// test_map_doubles returns each element doubled via map.
fn test_map_doubles(items []i32) []i32 {
    return map(items, _double);
}

// test_filter_evens returns only even elements via filter.
fn test_filter_evens(items []i32) []i32 {
    return filter(items, _is_even);
}

// test_reduce_sum returns the sum of all elements via reduce.
fn test_reduce_sum(items []i32, initial i32) i32 {
    return reduce(items, initial, _sum);
}

// test_find_even returns the first even element (wrapped in ?i32) via find.
fn test_find_even(items []i32) ?i32 {
    return find(items, _is_even);
}

// test_any_even returns true if any element is even via any.
fn test_any_even(items []i32) bool {
    return any(items, _is_even);
}

// test_all_nonzero returns true if every element is nonzero via all.
fn test_all_nonzero(items []i32) bool {
    return all(items, _to_bool);
}

// test_zip_pairs returns zipped pairs of two integer slices via zip.
fn test_zip_pairs(a []i32, b []i32) [](i32, i32) {
    return zip(a, b);
}
