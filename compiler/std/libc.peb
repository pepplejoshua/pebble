extern {
  fn assert(cond bool) void;
  fn exit(code int) void;

  fn malloc(sz uint) *void;
  fn realloc(ptr *void, sz uint) *void;
  fn free(ptr *void) void;

  fn strcmp(a str, b str) i32;
  fn strcpy(dest str, src str) str;
  fn strncpy(dest str, src str, sz uint) str;
  fn strncmp(a str, b str, size uint) i32;
  fn strlen(s str) uint;
  fn strcat(dest str, src str) str;
  fn strncat(dest str, src str, sz uint) str;
  fn strdup(string str) str;
  fn strndup(string str, sz uint) str;
  fn atof(string str) f64;
  fn atol(string str) i64;

  fn memcpy(dest *void, src *void, size uint) *void;
  fn memset(dest *void, value int, size uint) void;
  fn system(__command str) int;
}
