import "std:io";
import "std:string";

fn main() int {
    var path = "read_file_demo.txt";
    var file = io::open(path, io::MODE_READ);

    if file != nil {
        var contents = io::read_all(file);
        defer string::delete(&contents);

        // String is byte-oriented: byte length and character count genuinely
        // differ for multi-byte content, so iterate by byte position and
        // advance by each decoded character's own UTF-8 width.
        var pos = 0;
        while pos < contents.len {
            var width uint = 0;
            var c = contents.char_at(pos, &width);
            print c;
            pos += width;
        }
    } else {
        print "Cannot read ", path, ".";
    }

    return 0;
}
