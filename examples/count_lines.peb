import "std:io";
import "std:string";

type Stats = struct {
    lines uint;
    words uint;
    chars uint;
};

// Fills *stats with the line/word/char counts for filename. Returns false if
// the file could not be opened.
fn count_file(filename str, stats *Stats) bool {
    var file = io::open(filename, io::MODE_READ);
    if file == nil {
        return false;
    }

    var contents = io::read_all(file);
    io::close(file);

    stats.lines = 0;
    stats.words = 0;
    stats.chars = contents.len;

    // Count newline bytes. String.data is raw UTF-8 bytes, so byte-level
    // ASCII detection is correct here (no decoding needed).
    var i = 0;
    while i < contents.len {
        if contents.data[i] == ('\n' as u8) {
            stats.lines++;
        }
        i++;
    }

    // Add 1 to line count if file doesn't end with newline and has content
    if contents.len > 0 {
        var last_char = contents.data[contents.len - 1];
        if last_char != ('\n' as u8) {
            stats.lines++;
        }
    }

    // Count words
    var in_word = false;
    var j = 0;
    while j < contents.len {
        var c = contents.data[j];
        if c == (' ' as u8) || c == ('\t' as u8) || c == ('\n' as u8) || c == ('\r' as u8) {
            in_word = false;
        } else {
            if !in_word {
                stats.words++;
                in_word = true;
            }
        }
        j++;
    }

    string::delete(&contents);
    return true;
}

fn main() int {
    var total_stats Stats = Stats.{ lines = 0, words = 0, chars = 0 };
    var successful_files = 0;
    var paths = 10;

    // Count and report each file.
    var index = 0;
    while index < paths {
        var filename str = "";
        switch index {
        case 0: filename = "compiler/std/func.peb";
        case 1: filename = "compiler/std/hash.peb";
        case 2: filename = "compiler/std/hmap.peb";
        case 3: filename = "compiler/std/io.peb";
        case 4: filename = "compiler/std/libc.peb";
        case 5: filename = "compiler/std/mem.peb";
        case 6: filename = "compiler/std/set.peb";
        case 7: filename = "compiler/std/string.peb";
        case 8: filename = "compiler/std/vec.peb";
        case 9: filename = "compiler/std/mem/arena.peb";
        }

        var stats Stats = Stats.{ lines = 0, words = 0, chars = 0 };
        if count_file(filename, &stats) {
            total_stats.lines += stats.lines;
            total_stats.words += stats.words;
            total_stats.chars += stats.chars;
            successful_files++;
            print filename, ": ", stats.lines, " lines, ", stats.words, " words, ", stats.chars, " chars";
        } else {
            print "Error reading ", filename;
        }
        index++;
    }

    print "";
    print "Summary for ", successful_files, "/", paths, " files:";
    print "Total lines: ", total_stats.lines;
    print "Total words: ", total_stats.words;
    print "Total chars: ", total_stats.chars;

    return 0;
}
